# Copy this file to backend/.env. Never commit the copied file.

# Core application settings
APP_SUPERUSER_USERNAME=admin
APP_SUPERUSER_PASSWORD=change_this_password
APP_SECRET_KEY=replace_with_a_long_random_value
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Runtime storage (relative paths resolve from the backend working directory)
PROJECT_STORAGE_PATH=./storage/projects
CHROMA_DB_PATH=./storage/chroma
EXPORT_STORAGE_PATH=./storage/exports
SQLITE_DB_PATH=./storage/security_codewiki.db

# Local Ollama provider (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_THINK_ENABLED=false
OLLAMA_NUM_PREDICT=2048
OLLAMA_CONTEXT_LENGTH=8192

# OpenAI provider (optional)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120

# Gemini provider (optional)
GEMINI_API_KEY=
# Leave blank to resolve to gemini-2.5-flash.
GEMINI_DEFAULT_MODEL=
GEMINI_TIMEOUT_SECONDS=120

# Groq provider (optional)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_ACTIVE_MODELS=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_REASONING_FORMAT=not_supported
GROQ_INCLUDE_REASONING=false
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_TIMEOUT_SECONDS=120

# Local embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CLOUD_LLM_TIMEOUT_SECONDS=120

# Retrieval/evaluation configuration. Keep these stable for comparable formal runs.
SELECTED_FILE_MIN_CHUNKS=3
SELECTED_FILE_MAX_CHUNKS=5
COMPARE_SOURCE_CHUNK_LIMIT=10
PRIMARY_SOURCE_TOP_K=10
WIKI_CONTEXT_ENABLED=true
WIKI_CONTEXT_TOP_K=2
EVALUATION_CONFIG_REVISION=phase4.5-v1
PROMPT_VERSION=ask-v4.5
PROMPT_SERIALIZATION_VERSION=compact-evidence-v1
WIKI_PROMPT_VERSION=wiki-v4.5
DIAGNOSTIC_RAW_RESPONSE_MAX_CHARS=8000

# Repository import limits
MAX_TOTAL_FILES_TO_INDEX=2000
MAX_TOTAL_CHUNKS_TO_INDEX=10000
MAX_REPO_SIZE_MB=500
GIT_CLONE_TIMEOUT_SECONDS=300
