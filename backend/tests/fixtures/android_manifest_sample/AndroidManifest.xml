<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.security">
    <uses-permission android:name="android.permission.CAMERA" />
    <permission
        android:name="com.example.security.ADMIN_PERMISSION"
        android:protectionLevel="signature" />
    <uses-feature android:name="android.hardware.camera" />

    <application
        android:name=".SecurityApplication"
        android:permission="com.example.security.ADMIN_PERMISSION">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:permission="com.example.security.ADMIN_PERMISSION">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".MainAlias"
            android:targetActivity=".MainActivity"
            android:exported="false" />
        <service
            android:name=".AccountService"
            android:permission="com.example.security.ADMIN_PERMISSION"
            android:exported="false" />
        <receiver
            android:name=".AccountReceiver"
            android:exported="false" />
        <provider
            android:name=".DataProvider"
            android:authorities="com.example.security.data"
            android:readPermission="com.example.security.READ_DATA"
            android:writePermission="com.example.security.WRITE_DATA"
            android:grantUriPermissions="true"
            android:exported="false" />
    </application>
</manifest>
